# SwagCentral Environment Configuration

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/swagcentral

# Cloudinary Credentials (For storing & serving digital product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Automation Settings (Nodemailer - Gmail / SMTP / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=swagcentral012@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SwagCentral <swagcentral012@gmail.com>"

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SwagCentral"

# Super Admin Authentication (required - the app has no built-in defaults)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password
# Long random string used to sign admin login tokens
ADMIN_JWT_SECRET=generate_a_long_random_string

# PayU payment gateway (PayU Dashboard > Developer > API Keys)
# Use the Test Mode key/salt with PAYU_MODE=test first, then switch to the Live Mode key/salt and PAYU_MODE=live.
PAYU_MERCHANT_KEY=your_payu_key
PAYU_MERCHANT_SALT=your_payu_salt
PAYU_MODE=test
