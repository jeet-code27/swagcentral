# SwagCentral Environment Configuration

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/swagcentral

# Cloudinary Credentials (For storing & serving digital product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Automation Settings (Nodemailer - Gmail / SMTP / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=swagcentral012@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SwagCentral <swagcentral012@gmail.com>"

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SwagCentral"

# Admin Access Token / Password (for protecting /admin routes)
ADMIN_SECRET_KEY=admin123
